<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout

        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/fondo_degradado"


>


    <ImageView
            android:id="@+id/olaSuperior"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:src="@drawable/ola_superior"
            android:scaleType="fitXY"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- Título -->

    <!-- Campos -->
    <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Formulario de Cliente"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#070c0f"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="40dp" app:layout_constraintHorizontal_bias="0.444"/>
    <EditText
            android:id="@+id/nombre"
            android:layout_width="265dp"
            android:layout_height="45dp"
            android:hint="Nombre"
            android:inputType="textPersonName"
            android:textColor="#070c0f"
            android:background="@drawable/edittext_fondo"
            app:layout_constraintTop_toBottomOf="@id/textView2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />


    <EditText
            android:id="@+id/apellido"
            android:layout_width="264dp"
            android:layout_height="38dp"
            android:hint="Apellido"
            android:inputType="textPersonName"
            android:textColor="#070c0f"
            android:background="@drawable/edittext_fondo"
            app:layout_constraintTop_toBottomOf="@id/nombre"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

    <EditText
            android:id="@+id/contrasena"
            android:layout_width="258dp"
            android:layout_height="39dp"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:textColor="#070c0f"
            android:background="@drawable/edittext_fondo"
            app:layout_constraintTop_toBottomOf="@id/apellido"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

    <EditText
            android:id="@+id/direccion"
            android:layout_width="262dp"
            android:layout_height="41dp"
            android:hint="Dirección"
            android:inputType="textPostalAddress"
            android:textColor="#070c0f"
            android:background="@drawable/edittext_fondo"
            app:layout_constraintTop_toBottomOf="@id/contrasena"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

    <EditText
            android:id="@+id/telefono"
            android:layout_width="264dp"
            android:layout_height="42dp"
            android:hint="Teléfono"
            android:inputType="phone"
            android:textColor="#070c0f"
            android:background="@drawable/edittext_fondo"
            app:layout_constraintTop_toBottomOf="@id/direccion"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

    <EditText
            android:id="@+id/correo"
            android:layout_width="264dp"
            android:layout_height="39dp"
            android:hint="Correo electrónico"
            android:inputType="textEmailAddress"
            android:textColor="#070c0f"
            android:background="@drawable/edittext_fondo"
            app:layout_constraintTop_toBottomOf="@id/telefono"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

    <!-- Imagen -->

    <!-- Botones principales -->
    <ImageView
            android:id="@+id/imageView"
            android:layout_width="72dp"
            android:layout_height="68dp"
            android:src="@mipmap/marquez"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toBottomOf="@id/correo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"
            android:background="@drawable/rounded_bg" app:layout_constraintHorizontal_bias="0.831"/>

    <!-- RecyclerView -->

    <!-- Botón de segunda actividad -->
    <Button
            android:id="@+id/nuevapersona"
            android:layout_width="173dp"
            android:layout_height="55dp"
            android:text="Crear persona"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50"
            android:onClick="crearpersona"
            android:layout_marginHorizontal="40dp"
            android:padding="10dp"
            android:radius="50dp" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintHorizontal_bias="0.306"
            app:layout_constraintTop_toBottomOf="@+id/correo" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.063"/>
    <Button
            android:id="@+id/MostrarApikotlin"
            android:layout_width="180dp"
            android:layout_height="52dp"
            android:text="Mostrar Datos"
            android:textColor="#FFFFFF"
            android:backgroundTint="#f7b50c"
            android:onClick="crearmostrarpersonas"
            app:layout_constraintTop_toBottomOf="@id/nuevapersona"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="40dp"
            android:padding="10dp" app:layout_constraintHorizontal_bias="0.333"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintVertical_bias="0.0"/>
    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/RecyPersonas"
            android:layout_width="337dp"
            android:layout_height="146dp"
            app:layout_constraintTop_toBottomOf="@+id/MostrarApikotlin"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintHorizontal_bias="0.32"
            app:layout_constraintVertical_bias="0.314"/>
    <Button
            android:id="@+id/buttonSegundaActividad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Segunda Actividad"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5E35B1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="16dp"
            android:layout_marginEnd="16dp"/>

    <Button
            android:id="@+id/buttonvolver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volver"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5E35B1"
            android:onClick="volverpag"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="16dp"
            android:layout_marginEnd="16dp" />


</androidx.constraintlayout.widget.ConstraintLayout>
