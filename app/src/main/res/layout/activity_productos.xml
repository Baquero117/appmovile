<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/fondo_degradado"
        tools:context=".ProductosActivity">

    <!-- Ola superior decorativa -->
    <ImageView
            android:id="@+id/ola_superior"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:scaleType="fitXY"
            android:src="@drawable/ola_superior"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- Título principal -->
    <TextView
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Formulario de Producto"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#070c0f"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ola_superior"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

    <!-- Campo: Nombre -->
    <EditText
            android:id="@+id/nombreProducto"
            android:layout_width="265dp"
            android:layout_height="45dp"
            android:hint="Nombre del producto"
            android:inputType="text"
            android:textColor="#070c0f"
            android:background="@drawable/edittext_fondo"
            app:layout_constraintTop_toBottomOf="@id/textView3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

    <!-- Campo: Descripción -->
    <EditText
            android:id="@+id/descripcionProducto"
            android:layout_width="264dp"
            android:layout_height="45dp"
            android:hint="Descripción"
            android:inputType="textMultiLine"
            android:textColor="#070c0f"
            android:background="@drawable/edittext_fondo"
            app:layout_constraintTop_toBottomOf="@id/nombreProducto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

    <!-- Campo: Cantidad -->
    <EditText
            android:id="@+id/cantidadProducto"
            android:layout_width="258dp"
            android:layout_height="45dp"
            android:hint="Cantidad"
            android:inputType="number"
            android:textColor="#070c0f"
            android:background="@drawable/edittext_fondo"
            app:layout_constraintTop_toBottomOf="@id/descripcionProducto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

    <!-- Campo: Imagen -->
    <EditText
            android:id="@+id/imagenProducto"
            android:layout_width="262dp"
            android:layout_height="45dp"
            android:hint="URL de la imagen"
            android:inputType="textUri"
            android:textColor="#070c0f"
            android:background="@drawable/edittext_fondo"
            app:layout_constraintTop_toBottomOf="@id/cantidadProducto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

    <!-- Campo: ID del vendedor -->
    <EditText
            android:id="@+id/idVendedor"
            android:layout_width="264dp"
            android:layout_height="45dp"
            android:hint="ID del vendedor"
            android:inputType="number"
            android:textColor="#070c0f"
            android:background="@drawable/edittext_fondo"
            app:layout_constraintTop_toBottomOf="@id/imagenProducto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

    <!-- Campo: Estado -->
    <EditText
            android:id="@+id/estadoProducto"
            android:layout_width="264dp"
            android:layout_height="45dp"
            android:hint="Estado del producto"
            android:inputType="text"
            android:textColor="#070c0f"
            android:background="@drawable/edittext_fondo"
            app:layout_constraintTop_toBottomOf="@id/idVendedor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

    <!-- Botón crear producto -->
    <Button
            android:id="@+id/btnCrearProducto"
            android:layout_width="173dp"
            android:layout_height="55dp"
            android:text="Crear producto"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50"
            android:onClick="crearProducto"
            app:layout_constraintTop_toBottomOf="@id/estadoProducto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

    <!-- Botón mostrar productos -->
    <Button
            android:id="@+id/btnMostrarProductos"
            android:layout_width="180dp"
            android:layout_height="52dp"
            android:text="Mostrar productos"
            android:textColor="#FFFFFF"
            android:backgroundTint="#f7b50c"
            android:onClick="mostrarProductos"
            app:layout_constraintTop_toBottomOf="@id/btnCrearProducto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp" />

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/RecyProductos"
            android:layout_width="337dp"
            android:layout_height="160dp"
            app:layout_constraintTop_toBottomOf="@id/btnMostrarProductos"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/buttonvolver"
            android:layout_marginTop="12dp" />

    <!-- Botón volver -->
    <Button
            android:id="@+id/buttonvolver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volver"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5E35B1"
            android:onClick="volverpag"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="16dp"
            android:layout_marginEnd="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
